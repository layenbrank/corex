{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://corex.local/schemas/directive.schema.json",
  "title": "Corex Directive",
  "description": "YAML directive document executed by corex-engine",
  "type": "object",
  "required": ["name", "steps"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "inputs": { "type": "array" },
    "variables": { "type": "object" },
    "triggers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "expr"],
            "properties": {
              "type": { "const": "cron" },
              "expr": { "type": "string" },
              "timezone": {
                "type": "string",
                "description": "local | utc | ±HH:MM; overrides runtime.cron_timezone"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "paths"],
            "properties": {
              "type": { "const": "watch" },
              "paths": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "includes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "excludes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "debounce_ms": { "type": "integer", "minimum": 0 },
              "throttle_ms": { "type": "integer", "minimum": 1 },
              "immediate": { "type": "boolean", "default": false },
              "poll": { "type": "boolean", "default": false },
              "events": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["create", "modify", "remove", "access"]
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "permissions": { "type": "object" },
    "steps": { "type": "array", "minItems": 1 },
    "on_error": { "type": "string" }
  },
  "additionalProperties": true
}
