{
  "$defs": {
    "ActionStep": {
      "properties": {
        "action": {
          "description": "动作 id，如 `shell.run`、`file.write`。",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "on_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnError"
            },
            {
              "type": "null"
            }
          ]
        },
        "params": true,
        "retry": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "save_to": {
          "description": "把步骤输出存进某个变量名。",
          "type": [
            "string",
            "null"
          ]
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "action"
      ],
      "type": "object"
    },
    "Bucket": {
      "enum": [
        "system",
        "network",
        "data",
        "ui",
        "logic",
        "plugin"
      ],
      "type": "string"
    },
    "Condition": {
      "anyOf": [
        {
          "description": "真值表达式字符串，如 `\"{{variables.enabled}}\"`。",
          "type": "string"
        },
        {
          "properties": {
            "eq": {
              "items": true,
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "eq"
          ],
          "type": "object"
        },
        {
          "properties": {
            "ne": {
              "items": true,
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "ne"
          ],
          "type": "object"
        },
        {
          "properties": {
            "gt": {
              "items": true,
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "gt"
          ],
          "type": "object"
        },
        {
          "properties": {
            "lt": {
              "items": true,
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "lt"
          ],
          "type": "object"
        },
        {
          "description": "`contains: [haystack, needle]`。\n\n数组含元素、字符串含子串、map 含键。元素比较是宽松的：`0` 与 `\"0\"` 相等\n（服务端返回的分片序号是数字还是字符串不由指令决定）。",
          "properties": {
            "contains": {
              "items": true,
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "contains"
          ],
          "type": "object"
        },
        {
          "properties": {
            "and": {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            }
          },
          "required": [
            "and"
          ],
          "type": "object"
        },
        {
          "properties": {
            "or": {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            }
          },
          "required": [
            "or"
          ],
          "type": "object"
        },
        {
          "properties": {
            "not": {
              "$ref": "#/$defs/Condition"
            }
          },
          "required": [
            "not"
          ],
          "type": "object"
        }
      ],
      "description": "`when` / `if` 用的布尔 / 比较条件。"
    },
    "IfStep": {
      "properties": {
        "else": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "if": {
          "$ref": "#/$defs/Condition"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "if",
        "then"
      ],
      "type": "object"
    },
    "InputDecl": {
      "description": "声明的指令输入。",
      "properties": {
        "default": true,
        "description": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "OnError": {
      "description": "步骤失败时的反应方式。",
      "enum": [
        "abort",
        "continue",
        "skip"
      ],
      "type": "string"
    },
    "ParallelStep": {
      "properties": {
        "id": {
          "type": "string"
        },
        "max_concurrency": {
          "default": null,
          "description": "同时最多跑几个分支；省略用配置里的 `runtime.max_parallel`（默认 8）。",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "parallel": {
          "description": "一组写死的分支；每支拿一份上下文副本并发跑。",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "parallel"
      ],
      "type": "object"
    },
    "Permissions": {
      "description": "指令可能需要的声明权限。\n\n当**所有**标志都为 false（YAML 省略或为空）时，该指令被视为\n不设限（allow-all），以兼容简单指令的既有行为。\n一旦任一标志为 `true`，未声明的类别即被拒绝。",
      "properties": {
        "capture": {
          "default": false,
          "type": "boolean"
        },
        "clipboard": {
          "default": false,
          "type": "boolean"
        },
        "filesystem": {
          "default": false,
          "type": "boolean"
        },
        "network": {
          "default": false,
          "type": "boolean"
        },
        "notifications": {
          "default": false,
          "type": "boolean"
        },
        "secret": {
          "default": false,
          "type": "boolean"
        },
        "shell": {
          "default": false,
          "type": "boolean"
        },
        "ui": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RepeatSpec": {
      "description": "循环本体：`count` 与 `each` 必须设其一。\n\n跑法是串行还是并发，由外层 [`RepeatStep::max_concurrency`] 决定。",
      "properties": {
        "as": {
          "default": "item",
          "description": "当前元素绑到哪个变量名；`count` 时绑的是序号。",
          "type": "string"
        },
        "count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "each": {
          "description": "能解析成数组的表达式，如 `\"{{items}}\"`。",
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "default": "index",
          "description": "当前序号绑到哪个变量名。",
          "type": "string"
        }
      },
      "type": "object"
    },
    "RepeatStep": {
      "properties": {
        "id": {
          "type": "string"
        },
        "max_concurrency": {
          "default": null,
          "description": "并发度：同一时刻最多跑几个元素 / 几轮；省略或 `1` = 串行。\n\n与 `repeat` **同级**，一眼看得出这一步是不是并发的。两种跑法**语义不同**，\n不是纯性能开关：\n- 串行（默认）：元素共享一份上下文，前一个元素写下的变量后一个看得见，\n  适合元素之间有依赖的循环（累加、按序推进）。\n- 并发（`> 1`）：每个元素一份上下文副本，跑完按元素顺序合并回来，元素之间\n  互不可见，只适合互不依赖的元素。在途资源 ≈ `max_concurrency × 单元素占用`。",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "repeat": {
          "$ref": "#/$defs/RepeatSpec",
          "description": "循环本体：`count` 或 `each`，以及循环变量名。"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "repeat",
        "steps"
      ],
      "type": "object"
    },
    "Step": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionStep",
          "description": "普通动作调用。"
        },
        {
          "$ref": "#/$defs/IfStep",
          "description": "条件分支。"
        },
        {
          "$ref": "#/$defs/RepeatStep",
          "description": "重复 / 循环。"
        },
        {
          "$ref": "#/$defs/ParallelStep",
          "description": "并行运行子步骤。"
        },
        {
          "$ref": "#/$defs/StepsStep",
          "description": "顺序块（放最后：它只要求 `steps`，先试它会把 `repeat` / `if` 抢走）。"
        }
      ],
      "description": "单个流水线步骤或控制流节点。"
    },
    "StepsStep": {
      "description": "一组按顺序执行的步骤。\n\n`parallel` 的分支只能放**一个**步骤，而真实流程常常需要「算完摘要再 PATCH」\n这种两步一串的分支；把这组步骤收成一个步骤，语法上就装得下了。",
      "properties": {
        "id": {
          "description": "步骤 id。顺序块默认不写：块本身没有进度 / 引用，`{{steps.<id>}}` 指的是里面\n的步骤。带上它是为了让手写的分支「两条线各叫一个名字」，也免得编辑它的工具\n一保存就把名字抹掉（文档示例里带 id）。",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    },
    "Trigger": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "expr": {
              "type": "string"
            },
            "timezone": {
              "description": "local | utc | ±HH:MM; overrides runtime.cron_timezone",
              "type": "string"
            },
            "type": {
              "const": "cron"
            }
          },
          "required": [
            "type",
            "expr"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "debounce": {
              "default": "trailing",
              "description": "防抖执行时机(lodash leading/trailing): trailing 安静期结束跑一次(默认); leading 仅首次触发立即跑; both 首个立即跑+安静期结束补跑",
              "enum": [
                "leading",
                "trailing",
                "both"
              ],
              "type": "string"
            },
            "debounce_ms": {
              "minimum": 0,
              "type": "integer"
            },
            "events": {
              "items": {
                "enum": [
                  "create",
                  "modify",
                  "remove",
                  "access"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "excludes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "immediate": {
              "default": false,
              "type": "boolean"
            },
            "includes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "paths": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "poll": {
              "default": false,
              "type": "boolean"
            },
            "throttle": {
              "default": "both",
              "description": "节流执行时机(lodash leading/trailing): both 立即跑+窗口结束补跑一次(默认, 不丢改动); leading 仅首次立即跑; trailing 仅窗口结束跑一次",
              "enum": [
                "leading",
                "trailing",
                "both"
              ],
              "type": "string"
            },
            "throttle_ms": {
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "const": "watch"
            }
          },
          "required": [
            "type",
            "paths"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://corex.local/schemas/directive.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "YAML directive document executed by corex-engine",
  "properties": {
    "bucket": {
      "anyOf": [
        {
          "$ref": "#/$defs/Bucket"
        },
        {
          "type": "null"
        }
      ],
      "description": "分类，取 [`Bucket`] 的写法（与 `corex actions` 的分组同一套）；缺省为未分类。"
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputDecl"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "on_error": {
      "$ref": "#/$defs/OnError"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "type": "array"
    },
    "triggers": {
      "items": {
        "$ref": "#/$defs/Trigger"
      },
      "type": "array"
    },
    "variables": {
      "additionalProperties": true,
      "type": "object"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "steps"
  ],
  "title": "Corex Directive",
  "type": "object"
}
